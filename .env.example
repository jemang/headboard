# Copy to .env and fill in. Never commit .env — HEADSCALE_API_KEY is an
# all-access admin credential for your tailnet.

# ─── Required ────────────────────────────────────────────────────────────────

# Base URL of your existing Headscale, no trailing slash.
HEADSCALE_URL=https://headscale.example.com

# Admin API key: headscale apikeys create --expiration 90d
HEADSCALE_API_KEY=hskey-api-...

# The address DEVICES use to reach Headscale, if it differs from the one above.
# Headboard may reach Headscale over a Docker network or localhost, but the
# `tailscale up --login-server ...` command it generates has to name something a
# laptop can resolve. Defaults to HEADSCALE_URL.
# HEADSCALE_PUBLIC_URL=https://headscale.example.com

# ─── Everything below is optional ────────────────────────────────────────────

# Headboard's own store: accounts, sessions, audit log, policy history. A
# SQLite file — there is no database server to run. The container image points
# this at /data/headboard.db, which is a mounted volume.
# DATABASE_URL=headboard.db

# On first run Headboard creates an owner and prints its password once. This
# names that account.
# HEADBOARD_ADMIN_EMAIL=admin@headboard.local

# Set to 1 for one boot to mint a new password for that owner and print it
# again — the way back in if the password is lost or the identity provider
# breaks. Unset it afterwards.
# HEADBOARD_ADMIN_RESET=1

# Public browser address. It must use HTTPS outside HEADBOARD_DEV=true because
# session cookies are Secure in production. The OIDC redirect, if configured,
# is <HEADBOARD_PUBLIC_URL>/auth/callback.
HEADBOARD_PUBLIC_URL=https://headboard.example.com

# Headscale has no event stream, so this is the staleness bound on node
# online/offline state. Minimum 1s.
# HEADBOARD_POLL_INTERVAL=5s

# How long a login lasts.
# HEADBOARD_SESSION_LIFETIME=12h

# ─── Identity provider (optional; password login works without it) ───────────

# Use the SAME issuer as Headscale. Headboard links an account to its Headscale
# user on issuer + subject, and that only lines up when both sides trust the
# same provider. Sign-in by password keeps working alongside this.
# OIDC_ISSUER=https://authentik.example.com/application/o/headscale/
# OIDC_CLIENT_ID=headboard
# OIDC_CLIENT_SECRET=change-me

# Local development only: serve the UI from the Vite dev server.
# HEADBOARD_DEV=true
